<%- include('../includes/navigation.ejs') %>

    

<body class="body-index">
    <div class="table">
    <h2>Calendario de eventos</h2>
    <br><br>
    
    <% if (!posts || posts.length === 0) { %>
      <tr>
          <td colspan="3">No hay eventos programados</td>
      </tr>
  <% } else { %>
    
    <table class="table">
      <thead>
        <tr>
          
          <th>Fecha</th>
          <th>Evento</th>
          <th>Lugar</th>
          <th> </th>
        </tr>
      </thead>
      <tbody>

        

        <% for (let event of posts) { %>
            <tr>
              
          
              <td>
                
                <%= event.date %></td>
              <td>
                <% if (event.url) { %>
                    
                  <a href="<%= event.url %>"><%= event.title %></a>
                <% } else { %>
                  <%= event.title %>
                <% } %>
              </td>

              <td><%= event.place %></td>
              <td>
                <% if (locals.isAuthenticated && (locals.user.permissionLevel === 'superadmin' || locals.user.permissionLevel === 'admin')) { %>
                  <form action="/post/delete-event/<%= event._id %>" method="post" style="margin: 0px">
                      <input type="hidden" name="eventId" value="<%= event._id %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="button-add" id="button-edit">
                          <i class="fas fa-trash"></i>
                      </button>
                  </form>
                  <% } %>
              </td>
            </tr>
          <% } %>
        <% } %>
      </tbody>
    <table>
  </div>
  <div class="maps">

  </div>

</body>

 <!--- FOOTER (PIE DE PÁGINA)-->
 <%- include('../includes/footer') %>
</html>